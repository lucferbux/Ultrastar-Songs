# Firebase web app config (Firebase console → Project settings → Your apps → Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ultrastar-songs.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ultrastar-songs
VITE_FIREBASE_STORAGE_BUCKET=ultrastar-songs.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to true to talk to the local emulators (npm run emulators) instead of production.
VITE_USE_EMULATORS=false
